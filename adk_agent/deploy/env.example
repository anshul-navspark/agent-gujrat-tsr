# env_file for `adk deploy agent_engine --env_file=adk_agent/deploy/env.example`.
# Copy to env.prod, fill in, and keep secrets in Secret Manager (not here).

# --- Enterprise auth: Vertex AI via the deployment's service account + ADC ---
# No personal API key. The service account needs the "Vertex AI User" and
# "Gemini Enterprise Agent Platform User" roles.
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Model ---
GEMINI_MODEL_NAME=gemini-3.1-pro-preview

# --- Scraper tool (separate Cloud Run service; see scraper_service/) ---
# When set, survey-mode scraping is delegated to this service instead of running
# Selenium in the agent runtime. Leave unset for PDF-only deployments.
ANYROR_SCRAPER_URL=https://anyror-scraper-xxxxxxxx-uc.a.run.app
# Bearer token the agent sends; store the real value in Secret Manager.
ANYROR_SCRAPER_TOKEN=

# --- Optional: promote an optimizer-validated cheaper profile ---
# Leave unset to use the production 'full' prompt on gemini-3.1-pro.
# ADK_ACTIVE_PROFILE=/app/adk_agent/optimize/active_profile.json
