# Streamlit Cloud Secrets Configuration for Gujarat TSR Agent
# =========================================================
# 
# HOW TO USE:
# 1. Copy this file to .streamlit/secrets.toml (DO NOT commit secrets.toml!)
# 2. Fill in your actual values
# 3. For Streamlit Cloud deployment, add these secrets via:
#    https://share.streamlit.io > Your App > Settings > Secrets
#
# IMPORTANT: Never commit secrets.toml to git!
# The .gitignore should already exclude it.

# =============================================================
# REQUIRED SECRETS - The app will not work without these
# =============================================================

# Cloud Run API Configuration
# This is the URL of your deployed Cloud Run service
# Format: https://your-service-name-project-hash.region.run.app
API_URL = "https://agent-gujarat-tsr-642363716512.asia-south1.run.app"

# API Timeout in seconds
# TSR generation can take time, especially for complex documents
# Recommended: 900-1200 seconds (15-20 minutes)
API_TIMEOUT = 900

# Maximum retry attempts for failed API calls
API_MAX_RETRIES = 2

# =============================================================
# OPTIONAL SECRETS - Enhance functionality but not required
# =============================================================

# Google Gemini API Key (only needed if running TSR generation locally)
# For Streamlit Cloud UI-only deployment, this is NOT required
# as all processing happens on Cloud Run which has its own key
# GEMINI_API_KEY = "your-gemini-api-key-here"

# Maximum parallel workers for batch processing
# Higher values = faster batch processing but more API load
# Recommended: 20-30 for production
MAX_WORKERS = 30

# =============================================================
# ADVANCED SETTINGS - Usually don't need to change
# =============================================================

# Cache bucket name (used for direct GCS access if needed)
# GCS_CACHE_BUCKET = "your-project-id-tsr-cache"

# Debug mode (set to "true" to enable verbose logging)
# DEBUG = "false"
