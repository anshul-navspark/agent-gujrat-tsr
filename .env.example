# Copy to .env and fill in. NEVER commit a filled-in .env — it is git-ignored
# for a reason (see docs/journal.md, 2026-08-27 security entry).
# Secrets that must NOT live here or in .env: put them in .env.local (git-ignored).

# --- Extraction -------------------------------------------------------------
# Backend: "claude" (local Claude Code subscription, no API key) or "gemini".
EXTRACTION_BACKEND=claude
# The bare `opus` alias resolves to Opus 4.8 — pin the explicit model ID.
CLAUDE_EXTRACTION_MODEL=
CLAUDE_EXTRACTION_EFFORT=high
# USE_OPTIMIZED_EXTRACTION is inert — unified extraction is now unconditional.

# --- CAPTCHA ----------------------------------------------------------------
# The AnyRoR captcha is read by shelling out to the local `claude` CLI (same
# subscription auth as extraction, no API key). Defaults below are the bake-off
# winner over 15 real captchas: Opus 5 at HIGH effort scored 15/15, Opus at low
# 14/15, Sonnet 5 at low 12/15. There is deliberately NO fallback chain and NO
# retry inside the solver -- a miss costs a whole fresh AnyRoR session, so
# retries belong to ANYROR_FETCH_ATTEMPTS where the captcha is genuinely new.
# Override only for experiments. (CAPTCHA_MODEL_NAME is dead -- it named the
# old Gemini model.)
CAPTCHA_MODEL=claude-opus-5
CAPTCHA_EFFORT=high
CAPTCHA_TIMEOUT=120

# --- Scraper ----------------------------------------------------------------
# Scraping is browser-free and has no toggle: anyror/http_fetch.py is the only
# path. Selenium was the WAF block trigger, not a workaround (tested
# 2026-07-31 — blocked a fresh IP within ~4 min), so it was removed entirely.

# --- Optional / legacy ------------------------------------------------------
# Only needed if EXTRACTION_BACKEND=gemini. Left blank by default; the code must
# boot without it.
GEMINI_API_KEY=

# --- Secrets: set these in .env.local, NOT here ------------------------------
# ANYROR_PROXY=   # asocks Indian residential proxy, gateway port 443 only
