# AnyRoR Automation Environment Variables

# Azure OpenAI API credentials
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-api-key

# Optional: Chrome WebDriver path (if not using webdriver-manager)
# CHROME_DRIVER_PATH=/path/to/chromedriver

# Optional: Output directory for PDFs
# PDF_OUTPUT_DIR=/path/to/output/directory

# Optional: Logging configuration
# LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# CONSOLE_LOG_LEVEL=WARNING  # Only show warnings and errors in console
# FILE_LOG_LEVEL=INFO  # Keep detailed logs in the file
# LOG_FILE_PATH=logs/custom_log_name.log

# Optional: Browser configuration
# HEADLESS=true  # Set to false for visible browser
# DISABLE_GPU=true
# NO_SANDBOX=true

# Optional: Timeouts (in seconds)
# WAIT_TIMEOUT=20  # Default timeout for WebDriverWait
# CAPTCHA_WAIT_TIMEOUT=2  # Timeout for checking alert after form submission
# DROPDOWN_WAIT_TIMEOUT=3  # Timeout for dropdown staleness checks
# PAGE_LOAD_WAIT=3  # Wait time before PDF generation
# MAX_RETRIES=3  # Number of CAPTCHA retry attempts

# Optional: Performance settings
# DISABLE_BROWSER_LOGGING=true  # Suppress browser console logs
# DISABLE_WEBDRIVER_LOGS=true  # Suppress WebDriver Manager logs
# LRU_CACHE_SIZE=64  # Size of LRU cache for dropdown options

# WebDriver Manager settings
# WDM_LOG_LEVEL=0  # Suppress WebDriver Manager logs (0=OFF)
# WDM_PRINT_FIRST_LINE=False  # Don't print the first line of WebDriver Manager output 