[Unit]
Description=Gujarat TSR Agent Streamlit Application
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/gujrat_tsr_agent
Environment="PATH=/opt/gujrat_tsr_agent/venv/bin"
ExecStart=/opt/gujrat_tsr_agent/venv/bin/streamlit run app/streamlit_app.py --server.port=8501 --server.address=0.0.0.0 --server.headless=true

# Restart policy
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=streamlit

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Environment variables
EnvironmentFile=/opt/gujrat_tsr_agent/.env

[Install]
WantedBy=multi-user.target
